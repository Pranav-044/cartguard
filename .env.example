# ============================================================
# CartGuard Environment Configuration
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# ============================================================

# Razorpay Test-Mode Keys (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay Webhook Secret (set in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Gemini API Key (get from https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy...

# Database URL (SQLite - no external DB needed)
DATABASE_URL="file:./dev.db"

# App base URL (used by buyer agent script)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enable test-payment endpoint (ONLY for demo purposes, never in production)
ENABLE_TEST_PAYMENT=true

# Next.js public Razorpay key (safe to expose to client)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
